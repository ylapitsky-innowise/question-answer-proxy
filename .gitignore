# .gitignore  (в корне)

# IDE
.idea/
*.iml
*.iws
*.ipr
#.mvn/
.vscode/

# Build
target/
out/
*.jar
*.war

# Logs
*.log
logs/

# Secrets
.env
.env.*
!.env.example
*.p12
*.pem
*.key
credentials/
service-account-key.json
application-local.*
application-dev.*
application-prod.*

# Внешние конфиги
config/sources.yaml
config/*.yaml
!config/sources.example.yaml
