<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

    <groupId>com.innowise</groupId>
    <artifactId>question-answer-proxy</artifactId>
    <version>1.0.0</version>
    <name>question-answer-proxy</name>
    <description>Proxy service for Google Sheets</description>

    <properties>
        <java.version>17</java.version>
        <spring-data-commons.version>3.2.3</spring-data-commons.version>
        <google-sheets.version>v4-rev20230815-2.0.0</google-sheets.version>
        <google-auth.version>1.23.0</google-auth.version>
        <lombok.version>1.18.30</lombok.version>
    </properties>

	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>




	<dependencies>
