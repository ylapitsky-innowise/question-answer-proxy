# Dockerfile (в корне)

# ============================================================
# Образ с Java 17 (JDK нужен для сборки Maven Wrapper)
# ============================================================
FROM eclipse-temurin:17-jdk-alpine

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем файлы проекта и собираем JAR (тесты пропускаем — они не нужны на проде)
COPY . .

# Даем права на выполнение mvnw и собираем проект
RUN chmod +x mvnw && ./mvnw clean package -DskipTests

# Открываем порт, который использует приложение
EXPOSE 8080

# Запускаем приложение
# ============================================================
# JVM-флаги под Render Free (512 МБ RAM, 0.1 CPU):
#   -Xmx256m              — куча не более 256 МБ
#   -Xms128m              — стартовый размер кучи
#   -XX:MaxMetaspaceSize  — потолок Metaspace (классы, рефлексия)
#   -XX:+UseSerialGC      — лёгкий GC без нативных потоков, экономит RAM
# ============================================================
CMD ["java", "-Xmx256m", "-Xms128m", "-XX:MaxMetaspaceSize=96m", "-XX:+UseSerialGC", "-jar", "target/question-answer-proxy-1.0.0.jar"]
